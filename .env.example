# Copy to .env.local for local development. In production, set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Resend API key (https://resend.com/api-keys). If unset, the contact form shows a mailto: fallback instead of sending.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
RESEND_FROM="Ordine Ermetico <website@ordineermetico.com>"
# Where enquiries are delivered.
CONTACT_TO=office@ordineermetico.com
# Canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://ordineermetico.com
